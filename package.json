{
  "name": "scheme-saathi-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "seed": "npm run seed --workspace=server",
    "ingest": "npm run ingest --workspace=server",
    "validate": "npm run validate --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
