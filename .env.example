# Scheme-Saathi Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/scheme_saathi

# Authentication & Security
JWT_SECRET=dev_super_secret_jwt_key_change_in_production_min32chars!
ADMIN_EMAIL=superadmin@schemesaathi.in
ADMIN_PASSWORD="AdminSecurePass#2026"

# AI & LLM Service (@google/genai)
# Set USE_MOCK_AI=true to run completely offline without an API key using deterministic mock adapters
USE_MOCK_AI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot API (Optional - for citizen reminders)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SchemeSaathiBot

# Civic Data & Nominatim Geocoding
NOMINATIM_USER_AGENT=SchemeSaathi/1.0 (contact: info@schemesaathi.in)

# Verification & Dev Flags
# When true, unverified schemes are shown in the public UI with an "Unverified" amber badge
SHOW_UNVERIFIED=true

# Client Environment (used in client/.env or Vite build)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
